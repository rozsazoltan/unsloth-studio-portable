<Window
    x:Class="StudioUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Unsloth Studio Desktop">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Background="Transparent"
              AutomationProperties.Name="Window drag area"
              AutomationProperties.AutomationId="SettingsTitleBarDragRegion" />
        <NavigationView x:Name="Navigation" Grid.Row="0" Grid.RowSpan="2"
                        PaneDisplayMode="Left" CompactPaneLength="48" OpenPaneLength="244"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True" Background="Transparent"
                        SelectionChanged="OnNavigationChanged">
            <NavigationView.PaneHeader>
                <StackPanel Margin="18,18,12,24" Spacing="5">
                    <TextBlock Text="UNSLOTH STUDIO" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="150" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavigationGeneralItem" Content="General" Tag="General" Icon="Setting" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavigationUpdateItem" Content="Update" Tag="Update" Icon="Download" Visibility="Collapsed" />
                <NavigationViewItem x:Name="NavigationExperimentalItem" Content="Experimental" Tag="Experimental">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="F0 M9,1 H15 V8 C15,8.45 15.11,8.86 15.32,9.27 L20.08,18.59 A3,3 0 0 1 17.4,23 H6.6 A3,3 0 0 1 3.92,18.59 L8.68,9.27 C8.89,8.86 9,8.45 9,8 Z M11,3 V8 C11,8.67 10.87,9.16 10.46,9.98 L5.7,19.3 A1,1 0 0 0 6.6,21 H17.4 A1,1 0 0 0 18.3,19.3 L13.54,9.98 C13.13,9.16 13,8.67 13,8 V3 Z M6.45,14 H17.55 A1,1 0 0 1 17.55,16 H6.45 A1,1 0 0 1 6.45,14 Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavigationAboutItem" Content="About" Tag="About" Icon="Help" />
            </NavigationView.FooterMenuItems>
            <Grid x:Name="PageContent">
                <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="40,30,40,40" Spacing="22">
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="PageEyebrow" Text="PREFERENCES" FontSize="11"
                                       FontWeight="SemiBold" CharacterSpacing="130"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="PageTitle" Text="General" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock x:Name="PageSummary" Text="Unsloth Studio Desktop settings."
                                       FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="PageHost" Spacing="18">
                            <StackPanel x:Name="GeneralPage" Spacing="12">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="18">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Studio management is not available yet." FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="This window is a minimal native shell. It does not install, update, or launch Studio."
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="UpdatePage" Visibility="Collapsed" Spacing="12">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="18">
                                    <TextBlock Text="Updates are not available in this minimal shell."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="ExperimentalPage" Visibility="Collapsed" />
                            <StackPanel x:Name="AboutPage" Visibility="Collapsed" Spacing="16">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="22">
                                    <StackPanel Spacing="18">
                                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                            <Image x:Name="AboutLogo" Source="icon-256.png" Width="60" Height="60"
                                                   Stretch="Uniform" AutomationProperties.Name="Unsloth Studio Desktop icon" />
                                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="Unsloth Studio Desktop" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="A native Windows companion for Unsloth Studio."
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13">
                                            <TextBlock Text="Studio management features are deferred. This companion does not bundle Unsloth Studio, mise, or uv."
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </Border>
                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Project &amp; licensing" FontSize="16" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <HyperlinkButton Content="View project source"
                                                                 NavigateUri="https://github.com/rozsazoltan/unsloth-studio-portable" />
                                                <HyperlinkButton Content="AGPL-3.0-or-later"
                                                                 NavigateUri="https://github.com/rozsazoltan/unsloth-studio-portable/blob/main/LICENSE" />
                                            </StackPanel>
                                            <TextBlock Text="Third-party components" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="This companion bundles Windows App SDK runtime files. The project uses C++/WinRT for native WinUI integration."
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <HyperlinkButton Content="Windows App SDK license (MIT)"
                                                                 NavigateUri="https://github.com/microsoft/WindowsAppSDK/blob/main/LICENSE" />
                                                <HyperlinkButton Content="C++/WinRT license (MIT)"
                                                                 NavigateUri="https://github.com/microsoft/cppwinrt/blob/master/LICENSE" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,4,0,0">
                                                <Image Source="Assets/datarose-logo.png" Width="26" Height="26" Stretch="Uniform"
                                                       AutomationProperties.Name="Datarose logo" />
                                                <HyperlinkButton Content="Datarose" NavigateUri="https://datarose.net"
                                                                 AutomationProperties.Name="Visit Datarose website" />
                                            </StackPanel>
                                            <TextBlock Text="Acknowledgments: Unsloth Studio, mise, and uv are planned manager dependencies; they are not included in this minimal shell."
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="DeveloperPage" Visibility="Collapsed" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Off" Click="DeveloperOffClicked" />
                                    <Button Content="Reset" Click="DeveloperResetClicked" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
